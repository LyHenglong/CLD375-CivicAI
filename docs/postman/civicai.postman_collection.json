              "pm.test('The error names the field: latitude', () => pm.expect(json.errors.map(e => e.field)).to.include('latitude'));",
              "pm.test('The message is readable and has no stack trace', () => { pm.expect(json.message).to.be.a('string'); pm.expect(pm.response.text()).to.not.include('Traceback'); });"
