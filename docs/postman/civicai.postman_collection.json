              "pm.test('The error names the field: latitude', () => pm.expect(json.errors.map(e => e.field)).to.include('latitude'));",
              "pm.test('The message is readable and has no stack trace', () => { pm.expect(json.message).to.be.a('string'); pm.expect(pm.response.text()).to.not.include('Traceback'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/predict",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "predict"
          ]
        },
        "description": "latitude must be a number. Expected: 422 naming latitude.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"complaint_type\": \"Illegal Parking\",\n  \"descriptor\": \"Blocked Hydrant\",\n  \"location_type\": \"Street/Sidewalk\",\n  \"borough\": \"QUEENS\",\n  \"incident_zip\": \"11372\",\n  \"open_data_channel_type\": \"ONLINE\",\n  \"latitude\": \"north of the park\",\n  \"longitude\": -73.890401,\n  \"created_at\": \"2026-03-29T11:12:40\"\n}",
          "options": {
